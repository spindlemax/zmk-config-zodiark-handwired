#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define NUMNAV 1 
#define ARROW 2 
#define FKEY 3

&studio_unlock

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                                  |  6   |  7    |  8    |  9   |   0   | DEL   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |   [    |                 |   ]   |  Y   |  U    |  I    |  O   |   P   | BSPC  |
// |layer1 |  A  |  S  |  D   |  F   |  G   |   -    |                 |   =   |   ;  |  H    |  J    |  K   |  L    | LGUI  |
// | SHIFT |  Z  |  X  |  C   |  V   |  F1  | layer2 | F2    | | F3    |  F5   |  /   |  B    |  N    |  M   |   .   | CAPS  |
// | LEFT  |RIGHT| `   | \  | | ALT  |     SHIFT     | ENTER | | ENTER |    SPACE     | BSPC  | ' "   | DOWN |  UP   | DOWN  |
            bindings = <
&kp ESC   &kp N1    &kp N2    &kp N3   &kp N4    &kp N5                                               &kp N6   &kp N7   &kp N8    &kp N9   &kp N0   &kp DEL
&kp TAB   &kp Q     &kp W     &kp E    &kp R     &kp T     &kp LBKT                         &kp EQUAL &kp Y    &kp U    &kp I     &kp O    &kp P    &kp BSPC
&mo 2     &kp A     &kp S     &kp D    &kp F     &kp G     &kp MINUS                        &kp RBKT  &kp SEMI &kp H    &kp J     &kp K    &kp L    &kp LGUI
&kp LGUI  &kp Z     &kp X     &kp C    &kp V     &kp F1    &mo 1      &kp F2      &kp F3    &kp F5    &kp FSLH &kp B    &kp N     &kp M    &kp DOT  &kp CAPS  
&kp LEFT  &kp RIGHT &kp GRAVE &kp BSLH           &kp LALT  &kp LSHFT  &kp RET     &kp LCTRL &kp SPACE &kp BSPC &kp SQT  &kp COMMA &kp UP   &kp DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NUMNAV_layer {
// ------------------------------------------------------------------------------------------------------------
// |       | F1  | F2  |  F3  |  F4  |  F5  |                                  |  F6  |  F7   |  F8   |  F9  |  F10  |       |
// |       |  7  |  8  |   9  |  =   |      |   [    |                 |   ]   |      |       |       |  F11 |  F12  |       |
// |       |  4  |  5  |   6  |  -   |      |   -    |                 |   =   |      | LEFT  |  UP   | DOWN | RIGHT |       |
// |       |  1  |  2  |   3  |  +   |      |        |       | |       |       |      | HOME  | PG UP | PG DN| END   |       |
// |       |  0  |  .  |   /  |  *   |               |       | |       |              |       |       |      |       |       |
            bindings = <
&trans     &kp F1    &kp F2    &kp F3     &kp F4      &kp F5                                   &kp F6   &kp F7   &kp F8    &kp F9      &kp F10    &trans
&trans     &trans    &kp N7    &kp N8     &kp N9      &kp EQUAL   &trans                 &trans   &trans   &trans   &trans    &kp F11     &kp F12    &trans
&trans     &trans    &kp N4    &kp N5     &kp N6      &kp MINUS   &trans                 &trans   &trans   &kp LEFT &kp UP    &kp DOWN    &kp RIGHT  &trans
&trans     &trans    &kp N1    &kp N2     &kp N3      &kp KP_PLUS &trans &trans  &trans  &trans   &trans   &kp HOME &kp PG_UP &kp PG_DN   &kp END    &trans
&trans     &trans    &kp N0    &kp DOT    &kp KP_MULTIPLY         &trans &trans  &trans  &trans            &trans   &trans    &trans      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |BTCLR  | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                                  |      |       |       |      |       | RESET |
// |       |     |     |      |      |      |        |                 |       |      |       |       |      |       |BLOADER|
// |       |     |     |      |      |      |        |                 |       |      |       |       |      |       |       |
// |       |     |     |      |      |      |        |       | |       |       |      |       |       |      |       |       |
// |       |     |     |      |      |               |       | |       |              |       |       |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                          &trans &trans &trans &trans &trans &sys_reset
&trans   &trans        &trans        &trans       &trans      &trans  &trans                 &trans  &trans &trans &trans &trans &trans &bootloader
&trans   &trans        &trans        &trans       &trans      &trans  &trans                 &trans  &trans &trans &trans &trans &trans &trans
&trans   &trans        &trans        &trans       &trans      &trans  &trans &trans  &trans  &trans  &trans &trans &trans &trans &trans &trans
&trans   &trans        &trans        &trans       &trans         &trans      &trans  &trans      &trans     &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
